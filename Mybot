    elif gtype == 'dart':
        val = (await context.bot.send_dice(chat_id, emoji=E_DART)).dice.value; await asyncio.sleep(2)
        if val == 6: win = amt * 4.0
        elif val == 5: win = amt * 2.0
    elif gtype == 'football':
        val = (await context.bot.send_dice(chat_id, emoji=E_FOOTBALL)).dice.value; await asyncio.sleep(2)
        if val in [3, 4, 5]: win = amt * 1.35; msg_txt = "⚽ GOL! (Oran: 1.35x)"
        else: msg_txt = "Kaçtı..."
        
    update_bal(uid, win, True)
    update_game_stats(uid, 'win' if win > 0 else 'loss')
    kb = InlineKeyboardMarkup([[InlineKeyboardButton(f"{E_REFRESH} Tekrar Oyna", callback_data=f"bet_{int(amt)}"), InlineKeyboardButton(f"{E_HOME} Ana Menü", callback_data="back_start")]])

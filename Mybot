# --- HAPP API & MARZBAN ---
def encrypt_with_happ_api(target_url):
    try:
        headers = {"Content-Type": "application/json"}
        payload = {"url": target_url}
        response = requests.post(HAPP_API_URL, json=payload, headers=headers, timeout=10)
        if response.status_code == 200:
            data = response.json()
            if "encrypted_link" in data:
                raw_code = data["encrypted_link"]
                if not raw_code.startswith("happ://"):
                    return f"happ://{raw_code}"
                return raw_code
            else:
                return None
        else:
            return None
    except Exception as e:
        print(f"Happ API Error: {e}")
        return None

def get_marzban_token():
    try:
        url, user, password, _ = get_panel_settings()
        login_url = f"{url}/api/admin/token"
        login_data = {"username": user, "password": password}
        r = requests.post(login_url, data=login_data, timeout=5)
        if r.status_code == 200:
            return r.json().get("access_token")
    except Exception as e:
        print(f"Token hatası: {e}")
    return None


        final_username = f"BOT-{package_name}-{clean_user}{rand_suffix}"
        
        headers = {"Authorization": f"Bearer {token}", "Content-Type": "application/json"}
        
        expire_timestamp = 0
        if days_limit > 0:
            expire_date = datetime.utcnow() + timedelta(days=int(days_limit))
            expire_timestamp = int(expire_date.timestamp())
        
        data_bytes = gb_limit * 1024 * 1024 * 1024 if gb_limit > 0 else 0
        
        payload = {
            "username": final_username,
            "proxies": {"shadowsocks": {"method": "chacha20-ietf-poly1305"}},
            "inbounds": {},
            "expire": expire_timestamp,
            "data_limit": int(data_bytes) if data_bytes > 0 else 0,
            "data_limit_reset_strategy": "no_reset"
        }
        
        create_url = f"{url}/api/user"
        r2 = requests.post(create_url, json=payload, headers=headers)
        
        if r2.status_code == 200:
            user_data = r2.json()
            try:
                r_get = requests.get(f"{url}/api/user/{final_username}", headers=headers)
                if r_get.status_code == 200:
                    user_data = r_get.json()
            except: pass
            
            sub_link = user_data.get("subscription_url", "")
            if sub_link and sub_link.startswith("/"):
                sub_link = f"{url}{sub_link}"
            
            final_happ_link = ""
            if sub_link:
                happ_link = encrypt_with_happ_api(sub_link)
                if happ_link:
                    final_happ_link = happ_link
                else:
                    final_happ_link = sub_link
            else:
                links = user_data.get("links", [])
                if links:
                    final_happ_link = links[0]
                else:
                    final_happ_link = "⚠️ Link oluşturulamadı."
            
            return True, "", expire_timestamp, final_happ_link, final_username
        else:
            return False, f"Oluşturma Hatası: {r2.text}", 0, "", ""
    except Exception as e:
        return False, f"API Hatası: {str(e)}", 0, "", ""


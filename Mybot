async def launch_game(update, context, amt, is_msg=False):
    uid = update.effective_user.id; u, _ = get_user(uid)
    if amt > u['balance'] or amt < 0.1: return MENU
    update_bal(uid, -amt); gtype = context.user_data.get('game_type', 'slots'); chat_id = update.effective_chat.id
    if not is_msg:
        try: await update.callback_query.message.delete()
        except: pass
        
    if gtype == 'mines':
        cells = [0]*16; [cells.__setitem__(i, 1) for i in random.sample(range(16), 3)]
        active_games[uid] = {"bet": amt, "cells": cells, "revealed": [False]*16, "step": 0, "last_click": time.time()}
        await context.bot.send_message(chat_id, f"{E_BOMB} <b>MINES</b>\nBahis: <code>{amt}</code>", reply_markup=get_mines_board(active_games[uid], bet_amt=amt), parse_mode=ParseMode.HTML); return MINES_LOOP
        
    if gtype == 'balloon':
        active_games[uid] = {"game": "balloon", "bet": amt, "mult": 1.0}
        await context.bot.send_message(chat_id, f"🎈 <b>Balon Şişiriliyor...</b>\n\nÇarpan: <b>1.00x</b>\n<i>Patlamadan parayı çek!</i>", reply_markup=get_balloon_board(1.0, False, amt), parse_mode=ParseMode.HTML)
        return BALLOON_LOOP
        
    win = 0; msg_txt = ""
    if gtype == 'slots':
        val = (await context.bot.send_dice(chat_id, emoji=E_SLOT)).dice.value; await asyncio.sleep(2)
        win = amt * (10 if val==64 else (5 if val==1 else (2 if val==43 else 0)))
    elif gtype == 'roulette':
        choice = context.user_data.get('game_choice')
        res_num = random.randint(1, 37)
        if res_num == 37: res_color = "green"
        elif res_num in RED_NUMBERS: res_color = "red"
        else: res_color = "black"
        
        sticker_index = res_num - 1
        if 0 <= sticker_index < len(ROULETTE_STICKERS):
            try: await context.bot.send_sticker(chat_id, ROULETTE_STICKERS[sticker_index])
            except: await context.bot.send_message(chat_id, f"🎡 <b>{res_num}</b>", parse_mode=ParseMode.HTML)
        else: 
            await context.bot.send_dice(chat_id, emoji="🎯")
            
        await asyncio.sleep(1)
        icon = '🟢' if res_color == 'green' else ('🔴' if res_color == 'red' else '⚫')
        msg_txt = f"Sonuç: {icon} <b>{res_num}</b>"
        if choice == res_color:
            if choice == 'green': win = amt * 29.0
            else: win = amt * 1.9
            
    elif gtype == 'rps':
        choice = context.user_data.get('game_choice')
        bot_choice = random.choice(['rock', 'paper', 'scissors'])
        map_emoji = {'rock': '✊', 'paper': '✋', 'scissors': '✌️'}
        await context.bot.send_message(chat_id, f"Bot Seçiyor... {E_ROBOT}"); await asyncio.sleep(1.5)
        msg_txt = f"Sen: {map_emoji[choice]} vs Bot: {map_emoji[bot_choice]}\n"
        if choice == bot_choice: win = amt
        elif (choice == 'rock' and bot_choice == 'scissors') or (choice == 'paper' and bot_choice == 'rock') or (choice == 'scissors' and bot_choice == 'paper'): win = amt * 1.5
    elif gtype == 'coin':

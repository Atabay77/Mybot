async def support_msg(update, context):
    user_id = update.effective_user.id
    user_name = update.effective_user.first_name
    recipients = [ADMIN_ID] + get_support_admins()
    kb = InlineKeyboardMarkup([[InlineKeyboardButton("Cevapla", callback_data=f"replyuser_{user_id}")]])
    info_header = (f"📞 <b>YENİ DESTEK MESAJI</b>\n👤 <b>Kimden:</b> <a href='tg://user?id={user_id}'>{html.escape(user_name)}</a>\n🆔 <b>ID:</b> <code>{user_id}</code>")
    if update.message.photo:
        photo_id = update.message.photo[-1].file_id; caption = update.message.caption if update.message.caption else ""
        final_caption = f"{info_header}\n\n💬 <b>Mesaj:</b> {html.escape(caption)}"
        for admin_id in recipients:
            try: await context.bot.send_photo(chat_id=admin_id, photo=photo_id, caption=final_caption, parse_mode=ParseMode.HTML, reply_markup=kb)
            except: pass
    else:
        msg_text = update.message.text if update.message.text else "Dosya/Sticker"
        final_msg = f"{info_header}\n\n💬 <b>Mesaj:</b>\n<blockquote>{html.escape(msg_text)}</blockquote>"
        for admin_id in recipients:
            try: await context.bot.send_message(chat_id=admin_id, text=final_msg, parse_mode=ParseMode.HTML, reply_markup=kb)
            except: pass
    close_kb = InlineKeyboardMarkup([[InlineKeyboardButton("🚫 Tiketi Kapat (Menü)", callback_data="end_ticket")]])
    await update.message.reply_text(f"{E_CHECK} <b>İletildi!</b> Cevap bekleyebilir veya yazmaya devam edebilirsiniz.", parse_mode=ParseMode.HTML, reply_markup=close_kb)
    return SUPPORT_USER

async def admin_reply_click(update, context):
    uid = update.effective_user.id
    if uid != ADMIN_ID and uid not in get_support_admins(): await update.callback_query.answer("Yetkiniz yok.", show_alert=True); return
    target_id = int(update.callback_query.data.split("_")[1])
    context.user_data['reply_target'] = target_id
    exit_kb = InlineKeyboardMarkup([[InlineKeyboardButton("🔙 Çıkış (Panel)", callback_data="admin_exit_reply")]])
    await update.callback_query.message.reply_text(f"{E_WRITE} <b>Kullanıcı ID: {target_id}</b>\n\n<i>Cevabınızı yazın. (Moddan çıkana kadar yazabilirsiniz)</i>", parse_mode=ParseMode.HTML, reply_markup=exit_kb)
    return SUPPORT_ADMIN

async def admin_reply_send(update, context):
    target_id = context.user_data.get('reply_target')
    if not target_id: await update.message.reply_text("Hata: Kullanıcı bulunamadı."); return ADMIN_PANEL
    kb_for_user = InlineKeyboardMarkup([[InlineKeyboardButton(f"{E_REPLY} Cevap Yaz", callback_data="start_ticket")]])
    msg_to_send = f"📞 <b>DESTEK EKİBİ</b>\n\n{update.message.text}"
    try:
        await context.bot.send_message(target_id, msg_to_send, parse_mode=ParseMode.HTML, reply_markup=kb_for_user)
        exit_kb = InlineKeyboardMarkup([[InlineKeyboardButton("🔙 Çıkış (Panel)", callback_data="admin_exit_reply")]])
        await update.message.reply_text("✅ <b>Gönderildi.</b> Devam edebilirsiniz.", parse_mode=ParseMode.HTML, reply_markup=exit_kb)
    except Exception as e:
        await update.message.reply_text(f"❌ Gönderilemedi: {e}")
    return SUPPORT_ADMIN


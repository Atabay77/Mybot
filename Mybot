def get_user(uid, name="Oyuncu"):
    is_new_user = False
    with sqlite3.connect(DB_FILE) as conn:
        cur = conn.cursor()
        cur.execute("SELECT * FROM users WHERE user_id=?", (uid,))
        u = cur.fetchone()
        if not u:
            create_user(uid, name)
            is_new_user = True
            cur.execute("SELECT * FROM users WHERE user_id=?", (uid,))
            u = cur.fetchone()
        
        if not u: return None, True
        
        if name and name != "Oyuncu" and u[1] != name:
            conn.execute("UPDATE users SET name=? WHERE user_id=?", (name, uid))
            
        cols = [description[0] for description in cur.description]
        row = dict(zip(cols, u))
        return row, is_new_user


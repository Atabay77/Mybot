def init_db():
    with sqlite3.connect(DB_FILE) as conn:
        conn.execute('''CREATE TABLE IF NOT EXISTS users 
                        (user_id INTEGER PRIMARY KEY, name TEXT, balance REAL, 
                        wins INTEGER DEFAULT 0, losses INTEGER DEFAULT 0, 
                        invited INTEGER DEFAULT 0, total_earned REAL DEFAULT 0, 
                        last_free_claim INTEGER DEFAULT 0, is_banned INTEGER DEFAULT 0,
                        total_withdrawn REAL DEFAULT 0,
                        contest_invites INTEGER DEFAULT 0)''')
        conn.execute('''CREATE TABLE IF NOT EXISTS subscriptions 
                        (id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER, 
                        package_name TEXT, happ_link TEXT, expire_date INTEGER, 
                        marzban_username TEXT, gb_limit INTEGER, notified INTEGER DEFAULT 0,
                        created_at INTEGER)''')
        # settings tablosuna withdraw_info_text eklendi
        conn.execute('''CREATE TABLE IF NOT EXISTS settings 
                        (id INTEGER PRIMARY KEY, panel_url TEXT, panel_user TEXT, 
                        panel_pass TEXT, exchange_text TEXT, withdraw_info_text TEXT)''')
        conn.execute('''CREATE TABLE IF NOT EXISTS support_admins (user_id INTEGER PRIMARY KEY)''')
        
        cur = conn.cursor()
        cur.execute("SELECT * FROM settings WHERE id=1")
        if not cur.fetchone():
            default_wd_text = "ℹ️ <b>Döviz Kuru:</b>\n• 50 HappStar = 10 TMT\n• 50 HappStar = 25 Telegram Star"
            conn.execute("INSERT INTO settings (id, panel_url, panel_user, panel_pass, exchange_text, withdraw_info_text) VALUES (1, ?, ?, ?, ?, ?)", 
                         (DEFAULT_MARZBAN_URL, DEFAULT_MARZBAN_USER, DEFAULT_MARZBAN_PASS, "50 happ star✨ = 25🌟", default_wd_text))
        
        # Sütun güncellemeleri
        try: conn.execute("ALTER TABLE users ADD COLUMN total_withdrawn REAL DEFAULT 0")
        except: pass
        try: conn.execute("ALTER TABLE users ADD COLUMN last_free_claim INTEGER DEFAULT 0")
        except: pass
        try: conn.execute("ALTER TABLE users ADD COLUMN invited INTEGER DEFAULT 0")
        except: pass
        try: conn.execute("ALTER TABLE users ADD COLUMN contest_invites INTEGER DEFAULT 0")
        except: pass
        try: conn.execute("ALTER TABLE settings ADD COLUMN withdraw_info_text TEXT")

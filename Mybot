async def mines_loop(update, context):
    q = update.callback_query; 
    uid = q.from_user.id
    if q.data == "back_start": 
        await q.answer()
        return await show_menu(update, context)
        
    if uid not in active_games or "cells" not in active_games[uid]: return await show_menu(update, context)
    g = active_games[uid]
    
    current_time = time.time()
    last_click = g.get('last_click', 0)
    if current_time - last_click < 0.8:
        await q.answer("⚠️ Çok hızlı tıklıyorsun! Yavaşla.", show_alert=True)
        return MINES_LOOP
    g['last_click'] = current_time

    if q.data == "cashout":
        await q.answer()
        prize = g["bet"] * MULTIPLIERS[g["step"]]
        update_bal(uid, prize, True); update_game_stats(uid, 'win'); del active_games[uid]
        await q.edit_message_text(f"{E_CHECK} <b>TEBRİKLER!</b>\n\nKazancınız: <code>{prize:.2f}</code> HappStar", reply_markup=InlineKeyboardMarkup([[InlineKeyboardButton(f"{E_HOME} Ana Menü", callback_data="back_start")]]), parse_mode=ParseMode.HTML); return MENU
    
    await q.answer()
    idx = int(q.data.split("_")[1])
    if g["cells"][idx]:
        del active_games[uid]; update_game_stats(uid, 'loss')
        await q.edit_message_text(f"{E_BOOM} <b>BOM! PATLADINIZ</b>", reply_markup=get_mines_board(g, True, g['bet']), parse_mode=ParseMode.HTML); return MENU
        
    g["revealed"][idx] = True; g["step"] += 1
    await q.edit_message_text(f"Kasa: <code>{g['bet'] * MULTIPLIERS[g['step']]:.2f}</code> HappStar", reply_markup=get_mines_board(g, bet_amt=g['bet']), parse_mode=ParseMode.HTML); return MINES_LOOP

async def balloon_loop(update, context):
    q = update.callback_query; await q.answer()
    uid = q.from_user.id
    if uid not in active_games or active_games[uid].get('game') != 'balloon': return await show_menu(update, context)
    g = active_games[uid]
    
    if q.data == "balloon_cashout":
        win_amt = g['bet'] * g['mult']
        update_bal(uid, win_amt, True)
        update_game_stats(uid, 'win')
        del active_games[uid]
        await q.edit_message_text(f"✅ <b>PARAYI ALDIN!</b>\n\n<blockquote>Çarpan: <b>{g['mult']:.2f}x</b>\nKazanç: <code>{win_amt:.2f}</code> HappStar</blockquote>", reply_markup=InlineKeyboardMarkup([[InlineKeyboardButton("Tekrar Oyna", callback_data=f"bet_{int(g['bet'])}"), InlineKeyboardButton("Menü", callback_data="back_start")]]), parse_mode=ParseMode.HTML)
        return MENU
    if q.data == "balloon_inflate":
        chance = 0.05 + (g['mult'] - 1.0) * 0.1
        if random.random() < chance:
            del active_games[uid]
            update_game_stats(uid, 'loss')
            await q.edit_message_text(f"💥 <b>GÜM! BALON PATLADI!</b>\n\nSon Çarpan: {g['mult']:.2f}x", reply_markup=get_balloon_board(g['mult'], True, g['bet']), parse_mode=ParseMode.HTML)
            return MENU
        else:
            g['mult'] += 0.10
            await q.edit_message_text(f"🎈 <b>Balon Şişiyor...</b>\n\nÇarpan: <b>{g['mult']:.2f}x</b>\n<i>Patlamadan devam et veya parayı al!</i>", reply_markup=get_balloon_board(g['mult'], False, g['bet']), parse_mode=ParseMode.HTML)
            return BALLOON_LOOP


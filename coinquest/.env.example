# Bu dosyayı .env olarak kopyala:  cp .env.example .env  ve düzenle:  nano .env
# ZORUNLU — @BotFather'dan aldığın token
BOT_TOKEN=

# Yönetici(ler). Çekim taleplerini onaylayan kişi. Virgülle çoğaltabilirsin.
ADMIN_IDS=5961747564

# Para birimi adı (TMT, TL, USD...)
MONEY_NAME=TMT

# Botun kullanıcı adı (@ olmadan). Davet linki ve "gruba ekle" butonu için.
# Boş bırakırsan bot açılışta kendi kendine bulur.
BOT_USERNAME=

# Veritabanı dosyası (varsayılan: bot klasöründe coinquest.db)
DB_PATH=

# Log seviyesi: DEBUG / INFO / WARNING
LOG_LEVEL=INFO
